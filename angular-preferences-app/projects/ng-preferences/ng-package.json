{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/ng-preferences",
  "lib": {
    "entryFile": "src/public-api.ts",
    "styleIncludePaths": [
      "src/assets/styles",
      "src/assets/themes",
      "src/assets/typography",
      "src/assets/filters"
    ]
  },
  "assets": [
    "src/assets",
    {
      "glob": "**/*.scss",
      "input": "src/assets",
      "output": "assets"
    },
    {
      "glob": "**/*.svg",
      "input": "src/assets",
      "output": "assets"
    }
  ]
}